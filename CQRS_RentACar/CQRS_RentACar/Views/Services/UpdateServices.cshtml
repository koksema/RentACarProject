@model CQRS_RentACar.CQRSPattern.Results.ServicesResults.GetServicesByIdQueryResult

@{
    ViewData["Title"] = "Hizmet Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">

    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-10">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="me-3"
                             style="
                                width:48px;
                                height:48px;
                                border-radius:12px;
                                background:#fff5e5;
                                color:#e6a020;
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                font-size:19px;
                             ">

                            <i class="fa fa-pencil"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-1">
                                Hizmet Güncelle
                            </h5>

                            <small class="text-muted">
                                @Model.Title hizmetinin bilgilerini
                                düzenleyebilirsiniz.
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body p-4">

                    <form asp-controller="Services"
                          asp-action="UpdateServices"
                          method="post">


                        <!-- ID -->
                        <input type="hidden"
                               name="ServicesId"
                               value="@Model.ServicesId" />


                        <div class="row g-4">


                            <!-- BAŞLIK -->
                            <div class="col-12">

                                <label class="form-label fw-semibold">
                                    Hizmet Başlığı
                                </label>

                                <input type="text"
                                       name="Title"
                                       value="@Model.Title"
                                       class="form-control"
                                       required />

                            </div>


                            <!-- AÇIKLAMA -->
                            <div class="col-12">

                                <label class="form-label fw-semibold">
                                    Açıklama
                                </label>

                                <textarea name="Description"
                                          class="form-control"
                                          rows="6"
                                          required>@Model.Description</textarea>

                            </div>


                            <!-- ICON -->
                            <div class="col-12">

                                <label class="form-label fw-semibold">
                                    İkon
                                </label>

                                <input type="text"
                                       name="IconUrl"
                                       id="serviceIcon"
                                       value="@Model.IconUrl"
                                       class="form-control" />

                                <small class="text-muted">
                                    Font Awesome ikon sınıfını değiştirebilirsiniz.
                                </small>

                            </div>


                            <!-- ICON PREVIEW -->
                            <div class="col-12">

                                <div class="bg-light rounded p-4 text-center">

                                    <small class="text-muted d-block mb-3">
                                        İkon Önizleme
                                    </small>

                                    <div style="
                                        width:70px;
                                        height:70px;
                                        border-radius:16px;
                                        background:white;
                                        color:#1688e7;
                                        margin:auto;
                                        display:flex;
                                        align-items:center;
                                        justify-content:center;
                                        font-size:28px;
                                        box-shadow:0 5px 20px rgba(0,0,0,.05);
                                    ">

                                        <i id="serviceIconPreview"
                                           class="@Model.IconUrl"></i>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <hr class="my-4" />


                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Services"
                               asp-action="AllServices"
                               class="btn btn-outline-secondary">

                                <i class="fa fa-arrow-left me-1"></i>
                                Vazgeç

                            </a>


                            <button type="submit"
                                    class="btn btn-warning text-white">

                                <i class="fa fa-save me-1"></i>
                                Değişiklikleri Kaydet

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const input =
            document.getElementById("serviceIcon");

        const preview =
            document.getElementById("serviceIconPreview");


        input.addEventListener("input", function () {

            const iconClass = this.value.trim();

            if (iconClass !== "") {
                preview.className = iconClass;
            }
            else {
                preview.className = "fa fa-cogs";
            }

        });

    });

</script>