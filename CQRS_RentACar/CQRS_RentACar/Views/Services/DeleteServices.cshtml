@model CQRS_RentACar.CQRSPattern.Results.ServicesResults.GetServicesByIdQueryResult

@{
    ViewData["Title"] = "Hizmet Sil";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">

    <div class="row justify-content-center">

        <div class="col-xl-7 col-lg-9">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-5 text-center">


                    <!-- DELETE ICON -->
                    <div style="
                        width:75px;
                        height:75px;
                        margin:0 auto 20px;
                        border-radius:50%;
                        background:#fff0f1;
                        color:#e63946;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        font-size:28px;
                    ">

                        <i class="fa fa-trash"></i>

                    </div>


                    <h4 class="fw-bold mb-2">
                        Hizmeti Sil
                    </h4>


                    <p class="text-muted mb-4">
                        Bu hizmeti sistemden silmek
                        istediğinize emin misiniz?
                    </p>


                    <!-- SERVICE CARD -->
                    <div class="bg-light rounded p-4 mb-4">


                        <!-- SERVICE ICON -->
                        <div style="
                            width:75px;
                            height:75px;
                            border-radius:16px;
                            background:white;
                            color:#1688e7;
                            margin:0 auto 20px;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            font-size:30px;
                            box-shadow:0 5px 20px rgba(0,0,0,.05);
                        ">

                            @if (!string.IsNullOrWhiteSpace(Model.IconUrl))
                            {
                                <i class="@Model.IconUrl"></i>
                            }
                            else
                            {
                                <i class="fa fa-cogs"></i>
                            }

                        </div>


                        <h5 class="fw-bold">
                            @Model.Title
                        </h5>


                        <p class="text-muted mb-4">
                            @Model.Description
                        </p>


                        <hr />


                        <div class="row text-start mt-3">

                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Hizmet ID
                                </small>

                                <strong>
                                    #@Model.ServicesId
                                </strong>

                            </div>


                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    İkon
                                </small>

                                <strong>
                                    @Model.IconUrl
                                </strong>

                            </div>

                        </div>

                    </div>


                    <!-- WARNING -->
                    <div class="alert alert-warning text-start">

                        <i class="fa fa-exclamation-triangle me-2"></i>

                        <strong>Dikkat:</strong>

                        Bu işlem geri alınamaz. Hizmet kaydı
                        sistemden kalıcı olarak silinecektir.

                    </div>


                    <!-- BUTTONS -->
                    <div class="d-flex justify-content-center gap-2 mt-4">


                        <a asp-controller="Services"
                           asp-action="AllServices"
                           class="btn btn-outline-secondary px-4">

                            <i class="fa fa-arrow-left me-1"></i>
                            Vazgeç

                        </a>


                        <form asp-controller="Services"
                              asp-action="DeleteServicesConfirmed"
                              method="post">

                            <input type="hidden"
                                   name="servicesId"
                                   value="@Model.ServicesId" />


                            <button type="submit"
                                    class="btn btn-danger px-4">

                                <i class="fa fa-trash me-1"></i>
                                Evet, Hizmeti Sil

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>