@model CQRS_RentACar.CQRSPattern.Results.AboutResults.GetAboutByIdQueryResult

@{
    ViewData["Title"] = "Hakkımızda Sil";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">

    <div class="row justify-content-center">

        <div class="col-xl-7 col-lg-9">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-5 text-center">


                    <!-- ICON -->

                    <div style="
                        width:75px;
                        height:75px;
                        margin:0 auto 20px;
                        border-radius:50%;
                        background:#fff0f1;
                        color:#e63946;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        font-size:28px;
                    ">

                        <i class="fa fa-trash"></i>

                    </div>


                    <h4 class="fw-bold mb-2">
                        Hakkımızda İçeriğini Sil
                    </h4>


                    <p class="text-muted mb-4">
                        Bu içeriği silmek istediğinize emin misiniz?
                    </p>


                    <!-- BİLGİ KUTUSU -->

                    <div class="text-start bg-light rounded p-4 mb-4">

                        <div class="mb-3">

                            <small class="text-muted d-block mb-1">
                                İçerik ID
                            </small>

                            <strong>
                                #@Model.AboutId
                            </strong>

                        </div>


                        <div class="mb-3">

                            <small class="text-muted d-block mb-1">
                                Başlık
                            </small>

                            <strong>
                                @Model.Title
                            </strong>

                        </div>


                        <div>

                            <small class="text-muted d-block mb-1">
                                Açıklama
                            </small>

                            <span>
                                @Model.Description
                            </span>

                        </div>

                    </div>


                    <!-- UYARI -->

                    <div class="alert alert-warning text-start">

                        <i class="fa fa-exclamation-triangle me-2"></i>

                        Bu işlem geri alınamaz. İçerik veritabanından
                        silinecektir.

                    </div>


                    <!-- BUTTONS -->

                    <div class="d-flex gap-2 justify-content-center mt-4">

                        <a asp-controller="About"
                           asp-action="AllAbouts"
                           class="btn btn-outline-secondary px-4">

                            <i class="fa fa-arrow-left me-1"></i>
                            Vazgeç

                        </a>


                        <form asp-controller="About"
                              asp-action="DeleteAboutConfirmed"
                              method="post">

                            <input type="hidden"
                                   name="aboutId"
                                   value="@Model.AboutId" />


                            <button type="submit"
                                    class="btn btn-danger px-4">

                                <i class="fa fa-trash me-1"></i>
                                Evet, Sil

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>