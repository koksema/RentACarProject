@model CQRS_RentACar.CQRSPattern.Commands.BookingCommands.UpdateBookingCommand

@{
    ViewData["Title"] = "Rezervasyon Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .booking-edit-page {
        background: #f6f8fb;
        min-height: calc(100vh - 70px);
        padding: 30px;
    }

    .booking-edit-card {
        max-width: 900px;
        margin: 0 auto;
        background: #fff;
        border: 1px solid #e7edf2;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(20, 40, 60, .06);
    }

    .booking-edit-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 30px;
    }

    .booking-edit-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #eaf4ff;
        color: #1688e7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .booking-edit-header h4 {
        margin: 0;
        color: #183149;
        font-size: 20px;
        font-weight: 700;
    }

    .booking-edit-header p {
        margin: 4px 0 0;
        color: #8c98a5;
        font-size: 12px;
    }

    .booking-form-label {
        font-size: 12px;
        font-weight: 600;
        color: #526575;
        margin-bottom: 7px;
    }

    .booking-form-control {
        border: 1px solid #dfe6ed;
        border-radius: 9px;
        min-height: 45px;
        font-size: 13px;
        color: #405365;
    }

        .booking-form-control:focus {
            border-color: #1688e7;
            box-shadow: 0 0 0 3px rgba(22, 136, 231, .10);
        }

    .booking-id-box {
        background: #f7f9fc;
        border: 1px solid #e6ebf0;
        border-radius: 9px;
        padding: 12px 15px;
        color: #607080;
        font-size: 12px;
    }

    .booking-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #edf0f3;
    }

    .booking-btn {
        border-radius: 8px;
        padding: 10px 20px;
        font-size: 12px;
        font-weight: 600;
    }
</style>


<div class="booking-edit-page">

    <div class="booking-edit-card">

        <!-- HEADER -->
        <div class="booking-edit-header">

            <div class="booking-edit-icon">
                <i class="fa fa-pencil"></i>
            </div>

            <div>
                <h4>Rezervasyon Güncelle</h4>

                <p>
                    Rezervasyon bilgilerini düzenleyebilirsiniz.
                </p>
            </div>

        </div>


        <!-- FORM -->
        <form asp-controller="Booking"
              asp-action="UpdateBooking"
              method="post">

            <!-- ID -->
            <input type="hidden"
                   asp-for="BookingId" />


            <div class="row g-4">

                <!-- REZERVASYON ID -->
                <div class="col-12">

                    <label class="booking-form-label">
                        Rezervasyon Numarası
                    </label>

                    <div class="booking-id-box">
                        #@Model.BookingId
                    </div>

                </div>


                <!-- PICK UP LOCATION -->
                <div class="col-md-6">

                    <label asp-for="PickUpLocation"
                           class="booking-form-label">

                        Alış Lokasyonu

                    </label>

                    <input asp-for="PickUpLocation"
                           class="form-control booking-form-control"
                           placeholder="Alış lokasyonu" />

                </div>


                <!-- DROP OFF LOCATION -->
                <div class="col-md-6">

                    <label asp-for="DropOffLocation"
                           class="booking-form-label">

                        Teslim Lokasyonu

                    </label>

                    <input asp-for="DropOffLocation"
                           class="form-control booking-form-control"
                           placeholder="Teslim lokasyonu" />

                </div>


                <!-- PICK UP DATE -->
                <div class="col-md-6">

                    <label asp-for="PickUpDate"
                           class="booking-form-label">

                        Alış Tarihi

                    </label>

                    <input asp-for="PickUpDate"
                           type="datetime-local"
                           class="form-control booking-form-control" />

                </div>


                <!-- DROP OFF DATE -->
                <div class="col-md-6">

                    <label asp-for="DropOffDate"
                           class="booking-form-label">

                        Teslim Tarihi

                    </label>

                    <input asp-for="DropOffDate"
                           type="datetime-local"
                           class="form-control booking-form-control" />

                </div>


                <!-- CAR ID -->
                <div class="col-md-6">

                    <label asp-for="CarId"
                           class="booking-form-label">

                        Araç ID

                    </label>

                    <input asp-for="CarId"
                           type="number"
                           class="form-control booking-form-control"
                           min="1" />

                    <small class="text-muted">
                        Rezervasyona atanacak aracın ID değeri.
                    </small>

                </div>

            </div>


            <!-- BUTTONS -->
            <div class="booking-actions">

                <a asp-controller="Booking"
                   asp-action="AllBookings"
                   class="btn btn-outline-secondary booking-btn">

                    <i class="fa fa-arrow-left me-1"></i>
                    Vazgeç

                </a>


                <button type="submit"
                        class="btn btn-primary booking-btn">

                    <i class="fa fa-save me-1"></i>
                    Değişiklikleri Kaydet

                </button>

            </div>

        </form>

    </div>

</div>