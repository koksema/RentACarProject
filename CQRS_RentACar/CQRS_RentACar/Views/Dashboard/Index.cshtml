@using CQRS_RentACar.Entities
@using System.Globalization

@{
    ViewData["Title"] = "Rent A Car Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var recentCars =
        ViewBag.RecentCars as List<Cars>
        ?? new List<Cars>();

    var recentBookings =
        ViewBag.RecentBookings as List<Booking>
        ?? new List<Booking>();

    var culture =
        new CultureInfo("tr-TR");

    var todayText =
        DateTime.Now.ToString(
            "dd MMMM yyyy",
            culture
        );

    var currentTime =
        DateTime.Now.ToString("HH:mm");

    int totalBookings =
        Convert.ToInt32(
            ViewBag.TotalBookingCount ?? 0
        );

    int upcomingBookings =
        Convert.ToInt32(
            ViewBag.UpcomingBookingCount ?? 0
        );

    int activeBookings =
        Convert.ToInt32(
            ViewBag.ActiveBookingCount ?? 0
        );

    int completedBookings =
        Convert.ToInt32(
            ViewBag.CompletedBookingCount ?? 0
        );
}

<style>

    .rac-dashboard {
        background: #f5f7fb;
        min-height: calc(100vh - 70px);
        padding: 28px;
    }

    .dashboard-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .dashboard-title h2 {
        margin: 0;
        color: #15283c;
        font-size: 29px;
        font-weight: 700;
    }

    .dashboard-title p {
        margin: 5px 0 0;
        color: #8493a5;
        font-size: 13px;
    }

    .dashboard-date {
        background: #fff;
        border: 1px solid #e3e9ef;
        border-radius: 11px;
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 11px 16px;
        min-width: 195px;
    }

    .dashboard-date-icon {
        width: 40px;
        height: 40px;
        border-radius: 9px;
        background: #edf5ff;
        color: #247fd7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .dashboard-date strong {
        display: block;
        color: #15283c;
        font-size: 13px;
    }

    .dashboard-date span {
        color: #98a4b1;
        font-size: 10px;
    }


    /* ÜST KART */

    .dashboard-card {
        border-radius: 13px;
        margin-bottom: 22px;
        box-shadow: 0 7px 20px rgba(20,40,60,.06);
    }

    .fuel-stat-card {
        height: 205px;
        padding: 23px;
        position: relative;
        overflow: hidden;
        color: #fff;
    }

        .fuel-stat-card.benzin {
            background: linear-gradient( 135deg, #ff9c27, #ff641f );
        }

        .fuel-stat-card.motorin {
            background: linear-gradient( 135deg, #25b9f4, #087df1 );
        }

    .fuel-main-icon {
        width: 62px;
        height: 62px;
        border-radius: 50%;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
        margin-bottom: 14px;
    }

    .benzin .fuel-main-icon {
        color: #ff6921;
    }

    .motorin .fuel-main-icon {
        color: #1389eb;
    }

    .fuel-name {
        font-size: 12px;
        font-weight: 600;
    }

    .fuel-value {
        font-size: 30px;
        font-weight: 700;
        color: #fff;
        margin: 2px 0 10px;
    }

    .fuel-update {
        font-size: 10px;
        opacity: .9;
    }

    .fuel-bg-icon {
        position: absolute;
        right: 15px;
        bottom: 12px;
        font-size: 75px;
        opacity: .12;
    }


    /* NORMAL STAT */

    .main-stat-card {
        background: #fff;
        border: 1px solid #edf0f4;
        height: 205px;
        padding: 22px;
    }

    .main-stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .main-stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
    }

        .main-stat-icon.car {
            background: #def9ee;
            color: #10aa7c;
        }

        .main-stat-icon.brand {
            background: #f0e6ff;
            color: #7d43d8;
        }

    .circle-stat {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        border: 9px solid #e9edf1;
        border-top-color: #28bf8b;
        border-right-color: #28bf8b;
    }

        .circle-stat.purple {
            border-top-color: #995fe5;
            border-right-color: #995fe5;
        }

    .main-stat-number {
        color: #15283c;
        font-size: 27px;
        font-weight: 700;
        margin-top: 19px;
    }

    .main-stat-title {
        color: #53687d;
        font-size: 15px;
    }

    .main-stat-desc {
        color: #9aa6b2;
        font-size: 10px;
        margin-top: 5px;
    }


    /* PANEL */

    .modern-panel {
        background: #fff;
        border: 1px solid #edf0f3;
        border-radius: 13px;
        margin-bottom: 22px;
        box-shadow: 0 7px 22px rgba(20,40,60,.05);
        overflow: hidden;
    }

    .modern-panel-header {
        min-height: 67px;
        padding: 16px 19px;
        border-bottom: 1px solid #edf1f4;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .panel-heading-wrap {
        display: flex;
        align-items: center;
        gap: 11px;
    }

        .panel-heading-wrap > i {
            color: #1389e8;
            font-size: 22px;
        }

        .panel-heading-wrap h5 {
            margin: 0;
            color: #15283c;
            font-size: 15px;
            font-weight: 600;
        }

        .panel-heading-wrap p {
            margin: 3px 0 0;
            color: #9ba6b3;
            font-size: 10px;
        }

    .modern-panel-body {
        padding: 18px;
    }


    /* CHART */

    .chart-container {
        height: 270px;
        position: relative;
    }


    /* DONUT */

    .booking-status-grid {
        display: grid;
        grid-template-columns: 220px 1fr;
        align-items: center;
        gap: 20px;
        min-height: 270px;
    }

    .donut-holder {
        height: 210px;
        position: relative;
    }

    .booking-status-list {
        border: 1px solid #edf0f3;
        border-radius: 11px;
        overflow: hidden;
    }

    .booking-status-item {
        padding: 14px;
        display: grid;
        grid-template-columns: 1fr 50px;
        gap: 10px;
        align-items: center;
    }

        .booking-status-item +
        .booking-status-item {
            border-top: 1px solid #edf0f3;
        }

    .booking-status-name {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #54677a;
        font-size: 11px;
    }

    .status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

        .status-dot.upcoming {
            background: #1599eb;
        }

        .status-dot.active {
            background: #20bd7a;
        }

        .status-dot.completed {
            background: #8e5de5;
        }

    .booking-status-count {
        color: #15283c;
        font-weight: 700;
        text-align: right;
    }


    /* TABLE */

    .dashboard-table {
        width: 100%;
        margin: 0;
    }

        .dashboard-table thead th {
            background: #f6f8fa;
            color: #536779;
            border: none;
            font-size: 10px;
            font-weight: 600;
            padding: 11px;
        }

        .dashboard-table tbody td {
            color: #637488;
            border-top: 1px solid #edf0f3;
            font-size: 10px;
            padding: 11px;
            vertical-align: middle;
        }

        .dashboard-table tbody tr:first-child td {
            border-top: none;
        }

    .car-table-info {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .car-mini-image {
        width: 47px;
        height: 31px;
        border-radius: 6px;
        object-fit: cover;
        background: #edf1f4;
    }

    .car-placeholder {
        width: 47px;
        height: 31px;
        border-radius: 6px;
        background: #e9f4fc;
        color: #1687e5;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .car-table-info strong {
        color: #15283c;
        font-size: 10px;
    }

    .dashboard-link {
        background: #eef7ff;
        color: #1784dd !important;
        padding: 7px 11px;
        border-radius: 6px;
        font-size: 9px;
        text-decoration: none !important;
    }

    .booking-location {
        color: #15283c;
        font-weight: 600;
    }

    .status-badge {
        border-radius: 12px;
        padding: 5px 9px;
        font-size: 9px;
        display: inline-block;
    }

        .status-badge.upcoming {
            background: #e4f3ff;
            color: #168be8;
        }

        .status-badge.active {
            background: #ddf7ea;
            color: #12a56a;
        }

        .status-badge.completed {
            background: #efe8fb;
            color: #8151cf;
        }


    /* MESAJ KART */

    .message-summary-body {
        min-height: 185px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .message-big-number {
        color: #15283c;
        font-size: 38px;
        font-weight: 700;
    }

    .message-label {
        color: #607286;
        font-size: 12px;
    }

    .message-description {
        color: #9ba6b2;
        font-size: 10px;
        margin: 8px 0 15px;
    }

    .message-main-icon {
        width: 78px;
        height: 78px;
        border-radius: 18px;
        background: #ffe8f0;
        color: #e92362;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
    }


    @@media(max-width:1100px) {

        .booking-status-grid {
            grid-template-columns: 1fr;
        }

        .donut-holder {
            max-width: 230px;
            margin: auto;
        }
    }

    @@media(max-width:767px) {

        .rac-dashboard {
            padding: 17px;
        }

        .dashboard-title-row {
            flex-direction: column;
            align-items: flex-start;
        }

        .dashboard-date {
            width: 100%;
        }
    }

</style>


<div class="rac-dashboard">

    <!-- HEADER -->

    <div class="dashboard-title-row">



        <div class="dashboard-date">

            <div class="dashboard-date-icon">
                <i class="fa fa-calendar"></i>
            </div>

            <div>

                <strong>
                    @todayText
                </strong>

                <span>
                    @currentTime
                </span>

            </div>

        </div>

    </div>


    <!-- =========================================
         ÜST KARTLAR
         ========================================= -->

    <div class="row">

        <!-- BENZİN -->

        <div class="col-xl-3 col-lg-6">

            <div class="
                dashboard-card
                fuel-stat-card
                benzin">

                <div class="fuel-main-icon">
                    <i class="fa fa-tint"></i>
                </div>

                <div class="fuel-name">
                    Güncel Benzin Fiyatı
                </div>

                <div class="fuel-value">
                    @ViewBag.GasolinePrice
                </div>

                <div class="fuel-update">

                    Son güncelleme:
                    @(ViewBag.FuelDate ?? "-")

                </div>

                <i class="
                    fa fa-line-chart
                    fuel-bg-icon">
                </i>

            </div>

        </div>


        <!-- MOTORİN -->

        <div class="col-xl-3 col-lg-6">

            <div class="
                dashboard-card
                fuel-stat-card
                motorin">

                <div class="fuel-main-icon">
                    <i class="fa fa-truck"></i>
                </div>

                <div class="fuel-name">
                    Güncel Motorin Fiyatı
                </div>

                <div class="fuel-value">
                    @ViewBag.DieselPrice
                </div>

                <div class="fuel-update">

                    Son güncelleme:
                    @(ViewBag.FuelDate ?? "-")

                </div>

                <i class="
                    fa fa-bar-chart
                    fuel-bg-icon">
                </i>

            </div>

        </div>


        <!-- ARAÇ -->

        <div class="col-xl-3 col-lg-6">

            <div class="
                dashboard-card
                main-stat-card">

                <div class="main-stat-top">

                    <div class="
                        main-stat-icon
                        car">

                        <i class="fa fa-car"></i>

                    </div>

                    <div class="circle-stat"></div>

                </div>

                <div class="main-stat-number">
                    @ViewBag.TotalCarCount
                </div>

                <div class="main-stat-title">
                    Toplam Araç
                </div>

                <div class="main-stat-desc">
                    Sistemde kayıtlı araç sayısı
                </div>

            </div>

        </div>


        <!-- MARKA -->

        <div class="col-xl-3 col-lg-6">

            <div class="
                dashboard-card
                main-stat-card">

                <div class="main-stat-top">

                    <div class="
                        main-stat-icon
                        brand">

                        <i class="fa fa-tags"></i>

                    </div>

                    <div class="
                        circle-stat
                        purple">
                    </div>

                </div>

                <div class="main-stat-number">
                    @ViewBag.TotalBrandCount
                </div>

                <div class="main-stat-title">
                    Toplam Marka
                </div>

                <div class="main-stat-desc">
                    Sistemdeki farklı marka sayısı
                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
         GRAFİKLER
         ========================================= -->

    <div class="row">

        <!-- AYLIK REZERVASYON -->

        <div class="col-xl-7 col-lg-7">

            <div class="modern-panel">

                <div class="modern-panel-header">

                    <div class="panel-heading-wrap">

                        <i class="fa fa-car"></i>

                        <div>

                            <h5>
                                Aylık Rezervasyon İstatistikleri
                            </h5>

                            <p>
                                Son 6 ayın rezervasyon sayıları
                            </p>

                        </div>

                    </div>

                    <span class="dashboard-link">
                        Son 6 Ay
                    </span>

                </div>

                <div class="modern-panel-body">

                    <div class="chart-container">

                        <canvas id="bookingChart"></canvas>

                    </div>

                </div>

            </div>

        </div>


        <!-- REZERVASYON DURUMU -->

        <div class="col-xl-5 col-lg-5">

            <div class="modern-panel">

                <div class="modern-panel-header">

                    <div class="panel-heading-wrap">

                        <i class="fa fa-pie-chart"></i>

                        <div>

                            <h5>
                                Rezervasyon Durumu
                            </h5>

                            <p>
                                Tüm rezervasyonların güncel durumu
                            </p>

                        </div>

                    </div>

                </div>

                <div class="modern-panel-body">

                    <div class="booking-status-grid">

                        <div class="donut-holder">

                            <canvas id="bookingStatusChart">
                            </canvas>

                        </div>


                        <div class="booking-status-list">


                            <div class="booking-status-item">

                                <div class="booking-status-name">

                                    <span class="
                                        status-dot
                                        upcoming">
                                    </span>

                                    Yaklaşan

                                </div>

                                <div class="booking-status-count">
                                    @upcomingBookings
                                </div>

                            </div>


                            <div class="booking-status-item">

                                <div class="booking-status-name">

                                    <span class="
                                        status-dot
                                        active">
                                    </span>

                                    Devam Eden

                                </div>

                                <div class="booking-status-count">
                                    @activeBookings
                                </div>

                            </div>


                            <div class="booking-status-item">

                                <div class="booking-status-name">

                                    <span class="
                                        status-dot
                                        completed">
                                    </span>

                                    Tamamlanan

                                </div>

                                <div class="booking-status-count">
                                    @completedBookings
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
         ALT TABLOLAR
         ========================================= -->

    <div class="row">


        <!-- SON ARAÇLAR -->

        <div class="col-xl-4 col-lg-6">

            <div class="modern-panel">

                <div class="modern-panel-header">

                    <div class="panel-heading-wrap">

                        <i class="fa fa-car"></i>

                        <div>

                            <h5>
                                Son Eklenen Araçlar
                            </h5>

                            <p>
                                Sisteme son eklenen 5 araç
                            </p>

                        </div>

                    </div>

                </div>

                <div class="modern-panel-body"
                     style="padding:0;">

                    <div class="table-responsive">

                        <table class="
                            dashboard-table">

                            <thead>

                                <tr>
                                    <th>Araç</th>
                                    <th>Yıl</th>
                                    <th>Fiyat</th>
                                </tr>

                            </thead>

                            <tbody>

                                @if (recentCars.Any())
                                {
                                    foreach (var car
                                    in recentCars)
                                    {
                                        <tr>

                                            <td>

                                                <div class="
                                                            car-table-info">

                                                    @if (!string.IsNullOrWhiteSpace(
                                                                                                car.CarsImg))
                                                    {
                                                        <img src="@car.CarsImg"
                                                             class="
                                                                            car-mini-image"
                                                             alt="Araç" />
                                                    }
                                                    else
                                                    {
                                                        <div class="
                                                                        car-placeholder">

                                                            <i class="
                                                                            fa fa-car">
                                                            </i>

                                                        </div>
                                                    }

                                                    <div>

                                                        <strong>
                                                            @car.Brand
                                                            @car.Model
                                                        </strong>

                                                        <div>
                                                            @car.Fuel
                                                        </div>

                                                    </div>

                                                </div>

                                            </td>

                                            <td>
                                                @car.Year
                                            </td>

                                            <td>
                                                @car.Price.ToString("N0") ₺
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="3"
                                            class="text-center">

                                            Araç bulunamadı.

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>


        <!-- SON REZERVASYONLAR -->

        <div class="col-xl-5 col-lg-6">

            <div class="modern-panel">

                <div class="modern-panel-header">

                    <div class="panel-heading-wrap">

                        <i class="fa fa-calendar"></i>

                        <div>

                            <h5>
                                Son Rezervasyonlar
                            </h5>

                            <p>
                                En son oluşturulan rezervasyonlar
                            </p>

                        </div>

                    </div>

                </div>


                <div class="modern-panel-body"
                     style="padding:0;">

                    <div class="table-responsive">

                        <table class="
                            dashboard-table">

                            <thead>

                                <tr>
                                    <th>Araç</th>
                                    <th>Lokasyon</th>
                                    <th>Tarih</th>
                                    <th>Durum</th>
                                </tr>

                            </thead>

                            <tbody>

                                @if (recentBookings.Any())
                                {
                                    foreach (var booking
                                    in recentBookings)
                                    {
                                        string status;
                                        string statusClass;

                                        if (booking.PickUpDate >
                                        DateTime.Now)
                                        {
                                            status =
                                            "Yaklaşan";

                                            statusClass =
                                            "upcoming";
                                        }
                                        else if (
                                        booking.PickUpDate <=
                                        DateTime.Now &&
                                        booking.DropOffDate >=
                                        DateTime.Now)
                                        {
                                            status =
                                            "Devam Ediyor";

                                            statusClass =
                                            "active";
                                        }
                                        else
                                        {
                                            status =
                                            "Tamamlandı";

                                            statusClass =
                                            "completed";
                                        }

                                        <tr>

                                            <td>

                                                <strong>
                                                    @booking.Car?.Brand
                                                    @booking.Car?.Model
                                                </strong>

                                            </td>

                                            <td>

                                                <div class="
                                                            booking-location">

                                                    @booking.PickUpLocation

                                                </div>

                                                <small>müş
                                                    →
                                                    @booking.DropOffLocation
                                                </small>

                                            </td>

                                            <td>

                                                @booking.PickUpDate
                                                .ToString("dd.MM.yyyy")

                                            </td>

                                            <td>

                                                <span class="
                                                            status-badge
                                                            @statusClass">

                                                    @status

                                                </span>

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="4"
                                            class="text-center">

                                            Rezervasyon bulunamadı.

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>


        <!-- MESAJLAR -->

        <div class="col-xl-3 col-lg-12">

            <div class="modern-panel">

                <div class="modern-panel-header">

                    <div class="panel-heading-wrap">

                        <div class="panel-heading-icon">
                            <i class="fa fa-envelope"></i>
                        </div>

                        <div>

                            <h5>
                                Müşteri Mesajları
                            </h5>

                            <p>
                                Gelen iletişim mesajları
                            </p>

                        </div>

                    </div>

                </div>


                <div class="modern-panel-body">

                    <div class="message-summary-body">

                        <div class="message-summary-content">

                            <div class="message-big-number">

                                @ViewBag.TotalMessageCount

                            </div>

                            <div class="message-label">

                                Toplam Mesaj

                            </div>

                            <div class="message-description">

                                Müşterilerden gelen mesajları
                                görüntüleyebilir ve yapay zeka
                                tarafından oluşturulan cevapları
                                inceleyebilirsiniz.

                            </div>


                            <a asp-controller="Message"
                               asp-action="AllMessage"
                               class="btn btn-primary btn-sm mt-3">

                                <i class="fa fa-envelope-open me-1"></i>

                                Mesajları Görüntüle

                            </a>

                        </div>


                        <div class="message-main-icon">

                            <i class="fa fa-envelope"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            // =====================================
            // AYLIK REZERVASYON GRAFİĞİ
            // =====================================

            const monthLabels =
                @Html.Raw(
                    ViewBag.MonthLabelsJson ?? "[]"
                                );

            const monthValues =
                @Html.Raw(
                                        ViewBag.MonthValuesJson ?? "[]"
                                );

            const bookingCanvas =
                document.getElementById(
                    "bookingChart"
                );

            if (bookingCanvas) {

                new Chart(
                    bookingCanvas.getContext("2d"),
                    {
                        type: "line",

                        data: {
                            labels: monthLabels,

                            datasets: [
                                {
                                    label:
                                        "Rezervasyon",

                                    data:
                                        monthValues,

                                    borderColor:
                                        "#1688e7",

                                    backgroundColor:
                                        "rgba(22,136,231,.12)",

                                    borderWidth: 3,

                                    pointRadius: 5,

                                    pointBackgroundColor:
                                        "#1688e7",

                                    fill: true,

                                    tension: 0.35
                                }
                            ]
                        },

                        options: {

                            responsive: true,

                            maintainAspectRatio:
                                false,

                            legend: {
                                display: false
                            },

                            scales: {

                                yAxes: [
                                    {
                                        ticks: {
                                            beginAtZero:
                                                true,

                                            precision:
                                                0
                                        },

                                        gridLines: {
                                            color:
                                                "#edf1f5"
                                        }
                                    }
                                ],

                                xAxes: [
                                    {
                                        gridLines: {
                                            color:
                                                "#f1f3f6"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                );
            }


            // =====================================
            // REZERVASYON DURUMU
            // =====================================

            const statusCanvas =
                document.getElementById(
                    "bookingStatusChart"
                );

            if (statusCanvas) {

                new Chart(
                    statusCanvas.getContext("2d"),
                    {
                        type: "doughnut",

                        data: {

                            labels: [
                                "Yaklaşan",
                                "Devam Eden",
                                "Tamamlanan"
                            ],

                            datasets: [
                                {
                                    data: [
                                        @upcomingBookings,
                                        @activeBookings,
                                        @completedBookings
                                    ],

                                    backgroundColor: [
                                        "#1599eb",
                                        "#20bd7a",
                                        "#8e5de5"
                                    ],

                                    borderWidth: 0
                                }
                            ]
                        },

                        options: {

                            responsive: true,

                            maintainAspectRatio:
                                false,

                            cutoutPercentage:
                                67,

                            legend: {
                                display: false
                            }
                        }
                    }
                );
            }

        }
    );

</script>