	.trip-estimate-note {
		display: block;
		margin-top: 10px;
		color: #82909e;
		font-size: 10px;
		line-height: 1.5;
	}

	.trip-estimate-loading {
		text-align: center;
		padding: 7px 0;
		color: #b6c0ca;
		font-size: 12px;
	}
</style>


