<script>

	const airportCoordinates =
		@Html.Raw(
			ViewBag.AirportCoordinatesJson
			?? "{}"
																)

</script>



<!-- ========================================================= -->
<!-- MESAFE + YAKIT HESAPLAMA                                  -->
<!-- ========================================================= -->

<script>

	document.addEventListener(
		"DOMContentLoaded",
		function () {

			/*
			 * Derece -> Radyan
			 */
			function toRad(value) {

				return value *
					Math.PI /
					180;
			}


			/*
			 * Haversine mesafe hesabı.
			 *
			 * Bu gerçek karayolu mesafesi değil,
			 * iki havalimanı arasındaki yaklaşık
			 * coğrafi mesafedir.
			 */
			function calculateDistance(
				lat1,
				lon1,
				lat2,
				lon2) {

				const earthRadius =
					6371;


				const dLat =
					toRad(
						lat2 - lat1
					);


				const dLon =
					toRad(
						lon2 - lon1
					);


				const a =
					Math.sin(dLat / 2) *
					Math.sin(dLat / 2)
					+
					Math.cos(
						toRad(lat1)
					)
					*
					Math.cos(
						toRad(lat2)
					)
					*
					Math.sin(dLon / 2)
					*
					Math.sin(dLon / 2);


				const c =
					2 *
					Math.atan2(
						Math.sqrt(a),
						Math.sqrt(1 - a)
					);


				return earthRadius * c;
			}



			/*
			 * Tek bir formun tahminini günceller.
			 */
			async function updateTripEstimate(
				form) {

				const pickupSelect =
					form.querySelector(
						".pickup-airport"
					);


				const dropoffSelect =
					form.querySelector(
						".dropoff-airport"
					);


				const estimateContainer =
					form.querySelector(
						".trip-estimate-container"
					);


				const loading =
					form.querySelector(
						".trip-estimate-loading"
					);


				if (
					!pickupSelect ||
					!dropoffSelect
				) {
					return;
				}


				const pickupCode =
					pickupSelect.value;


				const dropoffCode =
					dropoffSelect.value;


				/*
				 * İkisi de seçilmeden
				 * hesaplama yapma.
				 */
				if (
					!pickupCode ||
					!dropoffCode
				) {

					estimateContainer
						?.classList
						.add("d-none");

					return;
				}


				/*
				 * Aynı havalimanı seçilmişse
				 * mesafe 0.
				 */
				if (
					pickupCode ===
					dropoffCode
				) {

					estimateContainer
						?.classList
						.remove("d-none");


					form.querySelector(
						".estimated-distance"
					).textContent =
						"0 km";


					form.querySelector(
						".estimated-liters"
					).textContent =
						"0 L";


					form.querySelector(
						".estimated-gasoline"
					).textContent =
						"0,00 ₺";


					form.querySelector(
						".estimated-diesel"
					).textContent =
						"0,00 ₺";


					return;
				}


				const start =
					airportCoordinates[
						pickupCode
					];


				const end =
					airportCoordinates[
						dropoffCode
					];


				if (!start || !end) {

					console.log(
						"Havalimanı koordinatı bulunamadı:",
						pickupCode,
						dropoffCode
					);

					return;
				}


				const distance =
					calculateDistance(
						Number(
							start.latitude
						),
						Number(
							start.longitude
						),
						Number(
							end.latitude
						),
						Number(
							end.longitude
						)
					);


				loading
					?.classList
					.remove("d-none");


				estimateContainer
					?.classList
					.add("d-none");


				try {

					const response =
						await fetch(
							"/Booking/CalculateTripEstimate",
							{
								method:
									"POST",

								headers: {
									"Content-Type":
										"application/x-www-form-urlencoded"
								},

								body:
									"distanceKm=" +
									encodeURIComponent(
										distance
									)
							}
						);


					if (!response.ok) {

						throw new Error(
							"HTTP " +
							response.status
						);
					}


					const data =
						await response.json();

		if (!data.success) {

		alert(
			data.message ??
			"Tahmin hesaplanamadı."
		);

		return;
	}


					form.querySelector(
						".estimated-distance"
					).textContent =

						Number(
							data.distance
						)
						.toLocaleString(
							"tr-TR"
						)
						+
						" km";


					form.querySelector(
						".estimated-liters"
					).textContent =

						Number(
							data.liters
						)
						.toLocaleString(
							"tr-TR",
							{
								maximumFractionDigits:
									2
							}
						)
						+
						" L";


					form.querySelector(
						".estimated-gasoline"
					).textContent =

						Number(
							data.gasolineCost
						)
						.toLocaleString(
							"tr-TR",
							{
								minimumFractionDigits:
									2,

								maximumFractionDigits:
									2
							}
						)
						+
						" ₺";


					form.querySelector(
						".estimated-diesel"
					).textContent =

						Number(
							data.dieselCost
						)
						.toLocaleString(
							"tr-TR",
							{
								minimumFractionDigits:
									2,

								maximumFractionDigits:
									2
							}
						)
						+
						" ₺";


					estimateContainer
						?.classList
						.remove(
							"d-none"
						);
				}
				catch (error) {

					console.error(
						"Yolculuk tahmini hatası:",
						error
					);
				}
				finally {

					loading
						?.classList
						.add(
							"d-none"
						);
				}
			}



			/*
			 * İki slide'daki formları da
			 * ayrı ayrı çalıştır.
			 */
			const forms =
				document.querySelectorAll(
					".reservation-form"
				);


			forms.forEach(
				function (form) {

					const pickup =
						form.querySelector(
							".pickup-airport"
						);


					const dropoff =
						form.querySelector(
							".dropoff-airport"
						);


					pickup?.addEventListener(
						"change",
						function () {

							updateTripEstimate(
								form
							);
						}
					);


					dropoff?.addEventListener(
						"change",
						function () {

							updateTripEstimate(
								form
							);
						}
					);

				}
			);

		}
	);

</script>