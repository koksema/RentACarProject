@model CQRS_RentACar.CQRSPattern.Results.CarsResults.GetCarsByIdQueryResult

@{
    ViewData["Title"] = "Araç Sil";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">

    <div class="row justify-content-center">

        <div class="col-xl-7 col-lg-9">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-5 text-center">


                    <!-- SİLME İKONU -->
                    <div style="
                        width:75px;
                        height:75px;
                        margin:0 auto 20px;
                        border-radius:50%;
                        background:#fff0f1;
                        color:#e63946;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        font-size:28px;
                    ">

                        <i class="fa fa-trash"></i>

                    </div>


                    <h4 class="fw-bold mb-2">
                        Aracı Sil
                    </h4>


                    <p class="text-muted mb-4">
                        Bu aracı sistemden silmek istediğinize
                        emin misiniz?
                    </p>


                    <!-- ARAÇ BİLGİLERİ -->
                    <div class="bg-light rounded p-4 mb-4 text-start">


                        <!-- ARAÇ RESMİ -->
                        @if (!string.IsNullOrWhiteSpace(Model.CarsImg))
                        {
                            <div class="text-center mb-4">

                                <img src="@Model.CarsImg"
                                     alt="@Model.Brand @Model.Model"
                                     style="
                                            width:100%;
                                            max-width:300px;
                                            height:170px;
                                            object-fit:contain;
                                            border-radius:10px;
                                            background:white;
                                            padding:10px;
                                         " />

                            </div>
                        }


                        <div class="row g-4">


                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Araç ID
                                </small>

                                <strong>
                                    #@Model.CarsId
                                </strong>

                            </div>


                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Araç
                                </small>

                                <strong>
                                    @Model.Brand @Model.Model
                                </strong>

                            </div>


                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Günlük Fiyat
                                </small>

                                <strong>
                                    @Model.Price.ToString("N2") ₺
                                </strong>

                            </div>


                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Puan
                                </small>

                                <strong>
                                    @Model.Review / 5
                                </strong>

                            </div>


                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Yakıt
                                </small>

                                <strong>
                                    @Model.Fuel
                                </strong>

                            </div>


                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Vites
                                </small>

                                <strong>
                                    @Model.Transmission
                                </strong>

                            </div>


                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Model Yılı
                                </small>

                                <strong>
                                    @Model.Year
                                </strong>

                            </div>


                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Kilometre
                                </small>

                                <strong>
                                    @Model.Km.ToString("N0") KM
                                </strong>

                            </div>


                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Koltuk
                                </small>

                                <strong>
                                    @Model.Seat Kişi
                                </strong>

                            </div>

                        </div>

                    </div>


                    <!-- UYARI -->
                    <div class="alert alert-warning text-start">

                        <i class="fa fa-exclamation-triangle me-2"></i>

                        <strong>Dikkat:</strong>

                        Bu işlem geri alınamaz. Ayrıca bu araca bağlı
                        rezervasyonlar varsa veritabanı aracın silinmesine
                        izin vermeyebilir.

                    </div>


                    <!-- BUTONLAR -->
                    <div class="d-flex justify-content-center gap-2 mt-4">


                        <a asp-controller="Cars"
                           asp-action="AllCars"
                           class="btn btn-outline-secondary px-4">

                            <i class="fa fa-arrow-left me-1"></i>
                            Vazgeç

                        </a>


                        <form asp-controller="Cars"
                              asp-action="DeleteCarsConfirmed"
                              method="post">

                            <input type="hidden"
                                   name="carsId"
                                   value="@Model.CarsId" />


                            <button type="submit"
                                    class="btn btn-danger px-4">

                                <i class="fa fa-trash me-1"></i>
                                Evet, Aracı Sil

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>