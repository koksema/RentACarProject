@model CQRS_RentACar.CQRSPattern.Results.CarsResults.GetCarsByIdQueryResult

@{
    ViewData["Title"] = "Araç Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">

    <div class="row justify-content-center">

        <div class="col-xl-9 col-lg-10">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="me-3"
                             style="
                                width:48px;
                                height:48px;
                                border-radius:12px;
                                background:#fff5e5;
                                color:#e6a020;
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                font-size:19px;
                             ">

                            <i class="fa fa-pencil"></i>

                        </div>


                        <div>

                            <h5 class="fw-bold mb-1">
                                Araç Güncelle
                            </h5>

                            <small class="text-muted">
                                @Model.Brand @Model.Model aracının
                                bilgilerini düzenleyebilirsiniz.
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body p-4">

                    <form asp-controller="Cars"
                          asp-action="UpdateCars"
                          method="post">


                        <!-- ID -->
                        <input type="hidden"
                               name="CarsId"
                               value="@Model.CarsId" />


                        <div class="row g-4">


                            <!-- MARKA -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Marka
                                </label>

                                <input type="text"
                                       name="Brand"
                                       value="@Model.Brand"
                                       class="form-control"
                                       required />

                            </div>


                            <!-- MODEL -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Model
                                </label>

                                <input type="text"
                                       name="Model"
                                       value="@Model.Model"
                                       class="form-control"
                                       required />

                            </div>


                            <!-- RESİM -->
                            <div class="col-12">

                                <label class="form-label fw-semibold">
                                    Araç Görseli
                                </label>

                                <input type="text"
                                       name="CarsImg"
                                       value="@Model.CarsImg"
                                       class="form-control" />

                            </div>


                            <!-- FİYAT -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Günlük Fiyat
                                </label>

                                <div class="input-group">

                                    <input type="number"
                                           name="Price"
                                           value="@Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                           step="0.01"
                                           min="0"
                                           class="form-control"
                                           required />

                                    <span class="input-group-text">
                                        ₺
                                    </span>

                                </div>

                            </div>


                            <!-- PUAN -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Puan
                                </label>

                                <input type="number"
                                       name="Review"
                                       value="@Model.Review.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       step="0.1"
                                       min="0"
                                       max="5"
                                       class="form-control" />

                            </div>


                            <!-- KOLTUK -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Koltuk Sayısı
                                </label>

                                <input type="number"
                                       name="Seat"
                                       value="@Model.Seat"
                                       min="1"
                                       class="form-control" />

                            </div>


                            <!-- YIL -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Model Yılı
                                </label>

                                <input type="text"
                                       name="Year"
                                       value="@Model.Year"
                                       class="form-control" />

                            </div>


                            <!-- VİTES -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Vites
                                </label>

                                <select name="Transmission"
                                        class="form-select">

                                    <option value="@Model.Transmission">
                                        Mevcut: @Model.Transmission
                                    </option>

                                    <option value="Automatic">
                                        Otomatik
                                    </option>

                                    <option value="Manual">
                                        Manuel
                                    </option>

                                </select>

                            </div>


                            <!-- YAKIT -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Yakıt Türü
                                </label>

                                <select name="Fuel"
                                        class="form-select">

                                    <option value="@Model.Fuel">
                                        Mevcut: @Model.Fuel
                                    </option>

                                    <option value="Gasoline">
                                        Benzin
                                    </option>

                                    <option value="Diesel">
                                        Dizel
                                    </option>

                                    <option value="Electric">
                                        Elektrik
                                    </option>

                                    <option value="Hybrid">
                                        Hibrit
                                    </option>

                                </select>

                            </div>


                            <!-- KM -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Kilometre
                                </label>

                                <div class="input-group">

                                    <input type="number"
                                           name="Km"
                                           value="@Model.Km"
                                           min="0"
                                           class="form-control" />

                                    <span class="input-group-text">
                                        KM
                                    </span>

                                </div>

                            </div>

                        </div>


                        <hr class="my-4" />


                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Cars"
                               asp-action="AllCars"
                               class="btn btn-outline-secondary">

                                <i class="fa fa-arrow-left me-1"></i>
                                Vazgeç

                            </a>


                            <button type="submit"
                                    class="btn btn-warning text-white">

                                <i class="fa fa-save me-1"></i>
                                Değişiklikleri Kaydet

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>