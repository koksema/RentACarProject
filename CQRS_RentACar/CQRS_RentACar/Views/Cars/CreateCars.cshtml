@model CQRS_RentACar.CQRSPattern.Commands.CarsCommands.CreateCarsCommand

@{
    ViewData["Title"] = "Yeni Araç Ekle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">

    <div class="row justify-content-center">

        <div class="col-xl-9 col-lg-10">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="me-3"
                             style="
                                width:48px;
                                height:48px;
                                border-radius:12px;
                                background:#eaf4ff;
                                color:#1688e7;
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                font-size:19px;
                             ">

                            <i class="fa fa-car"></i>

                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">
                                Yeni Araç Ekle
                            </h5>

                            <small class="text-muted">
                                Filonuza yeni bir araç ekleyebilirsiniz.
                            </small>
                        </div>

                    </div>

                </div>


                <div class="card-body p-4">

                    <form asp-controller="Cars"
                          asp-action="CreateCars"
                          method="post">

                        <div class="row g-4">

                            <!-- MARKA -->
                            <div class="col-md-6">

                                <label asp-for="Brand"
                                       class="form-label fw-semibold">
                                    Marka
                                </label>

                                <input asp-for="Brand"
                                       class="form-control"
                                       placeholder="Örn: BMW"
                                       required />

                            </div>


                            <!-- MODEL -->
                            <div class="col-md-6">

                                <label asp-for="Model"
                                       class="form-label fw-semibold">
                                    Model
                                </label>

                                <input asp-for="Model"
                                       class="form-control"
                                       placeholder="Örn: 320i"
                                       required />

                            </div>


                            <!-- RESİM -->
                            <div class="col-12">

                                <label asp-for="CarsImg"
                                       class="form-label fw-semibold">
                                    Araç Görseli
                                </label>

                                <input asp-for="CarsImg"
                                       class="form-control"
                                       placeholder="/images/cars/arac.png" />

                                <small class="text-muted">
                                    Araç görselinin URL veya dosya yolunu girin.
                                </small>

                            </div>


                            <!-- FİYAT -->
                            <div class="col-md-6">

                                <label asp-for="Price"
                                       class="form-label fw-semibold">
                                    Günlük Fiyat
                                </label>

                                <div class="input-group">

                                    <input asp-for="Price"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control"
                                           required />

                                    <span class="input-group-text">
                                        ₺
                                    </span>

                                </div>

                            </div>


                            <!-- PUAN -->
                            <div class="col-md-6">

                                <label asp-for="Review"
                                       class="form-label fw-semibold">
                                    Puan
                                </label>

                                <input asp-for="Review"
                                       type="number"
                                       step="0.1"
                                       min="0"
                                       max="5"
                                       class="form-control"
                                       placeholder="4.5" />

                            </div>


                            <!-- KOLTUK -->
                            <div class="col-md-6">

                                <label asp-for="Seat"
                                       class="form-label fw-semibold">
                                    Koltuk Sayısı
                                </label>

                                <input asp-for="Seat"
                                       type="number"
                                       min="1"
                                       class="form-control"
                                       placeholder="5" />

                            </div>


                            <!-- YIL -->
                            <div class="col-md-6">

                                <label asp-for="Year"
                                       class="form-label fw-semibold">
                                    Model Yılı
                                </label>

                                <input asp-for="Year"
                                       class="form-control"
                                       placeholder="2025" />

                            </div>


                            <!-- VİTES -->
                            <div class="col-md-6">

                                <label asp-for="Transmission"
                                       class="form-label fw-semibold">
                                    Vites
                                </label>

                                <select asp-for="Transmission"
                                        class="form-select"
                                        required>

                                    <option value="">
                                        Vites seçiniz
                                    </option>

                                    <option value="Automatic">
                                        Otomatik
                                    </option>

                                    <option value="Manual">
                                        Manuel
                                    </option>

                                </select>

                            </div>


                            <!-- YAKIT -->
                            <div class="col-md-6">

                                <label asp-for="Fuel"
                                       class="form-label fw-semibold">
                                    Yakıt Türü
                                </label>

                                <select asp-for="Fuel"
                                        class="form-select"
                                        required>

                                    <option value="">
                                        Yakıt türü seçiniz
                                    </option>

                                    <option value="Gasoline">
                                        Benzin
                                    </option>

                                    <option value="Diesel">
                                        Dizel
                                    </option>

                                    <option value="Electric">
                                        Elektrik
                                    </option>

                                    <option value="Hybrid">
                                        Hibrit
                                    </option>

                                </select>

                            </div>


                            <!-- KM -->
                            <div class="col-md-6">

                                <label asp-for="Km"
                                       class="form-label fw-semibold">
                                    Kilometre
                                </label>

                                <div class="input-group">

                                    <input asp-for="Km"
                                           type="number"
                                           min="0"
                                           class="form-control"
                                           placeholder="25000" />

                                    <span class="input-group-text">
                                        KM
                                    </span>

                                </div>

                            </div>

                        </div>


                        <hr class="my-4" />


                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Cars"
                               asp-action="AllCars"
                               class="btn btn-outline-secondary">

                                <i class="fa fa-arrow-left me-1"></i>
                                Vazgeç

                            </a>


                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="fa fa-save me-1"></i>
                                Aracı Kaydet

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>