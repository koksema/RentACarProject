@model CQRS_RentACar.CQRSPattern.Results.TestimonialResults.GetTestimonialByIdQueryResult

@{
    ViewData["Title"] = "Müşteri Yorumu Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">

    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-10">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="me-3"
                             style="
                                width:48px;
                                height:48px;
                                border-radius:12px;
                                background:#fff5e5;
                                color:#e6a020;
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                font-size:19px;
                             ">

                            <i class="fa fa-pencil"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-1">
                                Müşteri Yorumu Güncelle
                            </h5>

                            <small class="text-muted">
                                @Model.Name kişisine ait yorumu düzenleyebilirsiniz.
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body p-4">

                    <form asp-controller="Testimonial"
                          asp-action="UpdateTestimonial"
                          method="post">


                        <input type="hidden"
                               name="TestimonialId"
                               value="@Model.TestimonialId" />


                        <div class="row g-4">


                            <!-- NAME -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Ad Soyad
                                </label>

                                <input type="text"
                                       name="Name"
                                       value="@Model.Name"
                                       class="form-control"
                                       required />

                            </div>


                            <!-- PROFESSION -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Meslek
                                </label>

                                <input type="text"
                                       name="Profession"
                                       value="@Model.Profession"
                                       class="form-control"
                                       required />

                            </div>


                            <!-- IMAGE -->
                            <div class="col-12">

                                <label class="form-label fw-semibold">
                                    Müşteri Görseli
                                </label>

                                <input type="text"
                                       name="ImgUrl"
                                       id="testimonialImageUrl"
                                       value="@Model.ImgUrl"
                                       class="form-control" />

                            </div>


                            <!-- STAR -->
                            <div class="col-12">

                                <label class="form-label fw-semibold">
                                    Değerlendirme
                                </label>

                                <select name="Star"
                                        id="starSelect"
                                        class="form-select"
                                        required>

                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (Model.Star == i)
                                        {
                                            <option value="@i" selected>
                                                @i Yıldız
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@i">
                                                @i Yıldız
                                            </option>
                                        }
                                    }

                                </select>


                                <div id="starPreview"
                                     class="mt-3"
                                     style="font-size:22px; color:#ffc107;">

                                    @for (int i = 0; i < Model.Star; i++)
                                    {
                                        <i class="fa fa-star me-1"></i>
                                    }

                                </div>

                            </div>


                            <!-- COMMENT -->
                            <div class="col-12">

                                <label class="form-label fw-semibold">
                                    Müşteri Yorumu
                                </label>

                                <textarea name="Comment"
                                          class="form-control"
                                          rows="6"
                                          required>@Model.Comment</textarea>

                            </div>


                            <!-- IMAGE PREVIEW -->
                            <div class="col-12">

                                <div class="bg-light rounded p-4 text-center">

                                    <small class="text-muted d-block mb-3">
                                        Mevcut Müşteri Görseli
                                    </small>

                                    <img id="testimonialImagePreview"
                                         src="@Model.ImgUrl"
                                         alt="@Model.Name"
                                         style="
                                            width:140px;
                                            height:140px;
                                            object-fit:cover;
                                            border-radius:50%;
                                            border:4px solid white;
                                            box-shadow:0 5px 20px rgba(0,0,0,.08);
                                         " />

                                </div>

                            </div>

                        </div>


                        <hr class="my-4" />


                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Testimonial"
                               asp-action="AllTestimonial"
                               class="btn btn-outline-secondary">

                                <i class="fa fa-arrow-left me-1"></i>
                                Vazgeç

                            </a>


                            <button type="submit"
                                    class="btn btn-warning text-white">

                                <i class="fa fa-save me-1"></i>
                                Değişiklikleri Kaydet

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        const imageInput =
            document.getElementById("testimonialImageUrl");

        const imagePreview =
            document.getElementById("testimonialImagePreview");

        const starSelect =
            document.getElementById("starSelect");

        const starPreview =
            document.getElementById("starPreview");


        imageInput.addEventListener("input", function () {

            imagePreview.src = this.value.trim();

        });


        starSelect.addEventListener("change", function () {

            const starCount = parseInt(this.value) || 0;

            starPreview.innerHTML = "";

            for (let i = 0; i < starCount; i++) {

                starPreview.innerHTML +=
                    '<i class="fa fa-star me-1"></i>';

            }

        });

    });
</script>