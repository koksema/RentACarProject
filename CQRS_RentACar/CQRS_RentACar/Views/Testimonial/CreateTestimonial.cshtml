@model CQRS_RentACar.CQRSPattern.Commands.TestimonialCommands.CreateTestimonialCommand

@{
    ViewData["Title"] = "Yeni Müşteri Yorumu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">

    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-10">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="me-3"
                             style="
                                width:48px;
                                height:48px;
                                border-radius:12px;
                                background:#eaf4ff;
                                color:#1688e7;
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                font-size:19px;
                             ">

                            <i class="fa fa-comment"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-1">
                                Yeni Müşteri Yorumu
                            </h5>

                            <small class="text-muted">
                                Sistemde gösterilecek yeni bir müşteri yorumu ekleyebilirsiniz.
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body p-4">

                    <form asp-controller="Testimonial"
                          asp-action="CreateTestimonial"
                          method="post">

                        <div class="row g-4">

                            <!-- NAME -->
                            <div class="col-md-6">

                                <label asp-for="Name"
                                       class="form-label fw-semibold">
                                    Ad Soyad
                                </label>

                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="Örn: Ahmet Yılmaz"
                                       required />

                            </div>


                            <!-- PROFESSION -->
                            <div class="col-md-6">

                                <label asp-for="Profession"
                                       class="form-label fw-semibold">
                                    Meslek
                                </label>

                                <input asp-for="Profession"
                                       class="form-control"
                                       placeholder="Örn: Yazılım Geliştirici"
                                       required />

                            </div>


                            <!-- IMAGE -->
                            <div class="col-12">

                                <label asp-for="ImgUrl"
                                       class="form-label fw-semibold">
                                    Müşteri Görseli
                                </label>

                                <input asp-for="ImgUrl"
                                       id="testimonialImageUrl"
                                       class="form-control"
                                       placeholder="/images/testimonial/customer.jpg" />

                                <small class="text-muted">
                                    Müşteri fotoğrafının URL veya dosya yolunu girin.
                                </small>

                            </div>


                            <!-- STAR -->
                            <div class="col-12">

                                <label asp-for="Star"
                                       class="form-label fw-semibold">
                                    Değerlendirme
                                </label>

                                <select asp-for="Star"
                                        id="starSelect"
                                        class="form-select"
                                        required>

                                    <option value="">Yıldız seçiniz</option>
                                    <option value="1">1 Yıldız</option>
                                    <option value="2">2 Yıldız</option>
                                    <option value="3">3 Yıldız</option>
                                    <option value="4">4 Yıldız</option>
                                    <option value="5">5 Yıldız</option>

                                </select>

                                <div id="starPreview"
                                     class="mt-3"
                                     style="font-size:22px; color:#ffc107;">
                                </div>

                            </div>


                            <!-- COMMENT -->
                            <div class="col-12">

                                <label asp-for="Comment"
                                       class="form-label fw-semibold">
                                    Müşteri Yorumu
                                </label>

                                <textarea asp-for="Comment"
                                          class="form-control"
                                          rows="6"
                                          placeholder="Müşteri yorumunu yazınız..."
                                          required></textarea>

                            </div>


                            <!-- IMAGE PREVIEW -->
                            <div class="col-12">

                                <div id="imagePreviewBox"
                                     class="bg-light rounded p-4 text-center d-none">

                                    <small class="text-muted d-block mb-3">
                                        Görsel Önizleme
                                    </small>

                                    <img id="testimonialImagePreview"
                                         src=""
                                         alt="Müşteri"
                                         style="
                                            width:130px;
                                            height:130px;
                                            object-fit:cover;
                                            border-radius:50%;
                                            border:4px solid white;
                                            box-shadow:0 5px 20px rgba(0,0,0,.08);
                                         " />

                                </div>

                            </div>

                        </div>


                        <hr class="my-4" />


                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Testimonial"
                               asp-action="AllTestimonial"
                               class="btn btn-outline-secondary">

                                <i class="fa fa-arrow-left me-1"></i>
                                Vazgeç

                            </a>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="fa fa-save me-1"></i>
                                Yorumu Kaydet

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        const imageInput =
            document.getElementById("testimonialImageUrl");

        const imagePreview =
            document.getElementById("testimonialImagePreview");

        const imageBox =
            document.getElementById("imagePreviewBox");

        const starSelect =
            document.getElementById("starSelect");

        const starPreview =
            document.getElementById("starPreview");


        imageInput.addEventListener("input", function () {

            const value = this.value.trim();

            if (value !== "") {

                imagePreview.src = value;
                imageBox.classList.remove("d-none");

            } else {

                imagePreview.src = "";
                imageBox.classList.add("d-none");

            }

        });


        starSelect.addEventListener("change", function () {

            const starCount = parseInt(this.value) || 0;

            starPreview.innerHTML = "";

            for (let i = 0; i < starCount; i++) {
                starPreview.innerHTML +=
                    '<i class="fa fa-star me-1"></i>';
            }

        });

    });
</script>