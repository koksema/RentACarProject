@model CQRS_RentACar.CQRSPattern.Results.FeaturesResults.GetFeaturesByIdQueryResult

@{
    ViewData["Title"] = "Özellik Sil";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">

    <div class="row justify-content-center">

        <div class="col-xl-7 col-lg-9">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-5 text-center">


                    <!-- DELETE ICON -->
                    <div style="
                        width:75px;
                        height:75px;
                        margin:0 auto 20px;
                        border-radius:50%;
                        background:#fff0f1;
                        color:#e63946;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        font-size:28px;
                    ">

                        <i class="fa fa-trash"></i>

                    </div>


                    <h4 class="fw-bold mb-2">
                        Özelliği Sil
                    </h4>


                    <p class="text-muted mb-4">
                        Bu özelliği sistemden silmek
                        istediğinize emin misiniz?
                    </p>


                    <!-- FEATURE INFORMATION -->
                    <div class="bg-light rounded p-4 mb-4 text-start">


                        @if (!string.IsNullOrWhiteSpace(Model.ImgUrl))
                        {
                            <div class="text-center mb-4">

                                <img src="@Model.ImgUrl"
                                     alt="@Model.Title"
                                     style="
                                            width:100%;
                                            max-width:400px;
                                            height:200px;
                                            object-fit:cover;
                                            border-radius:12px;
                                         " />

                            </div>
                        }


                        <div class="mb-3">

                            <small class="text-muted d-block mb-1">
                                Özellik ID
                            </small>

                            <strong>
                                #@Model.FeaturesId
                            </strong>

                        </div>


                        <div class="mb-3">

                            <small class="text-muted d-block mb-1">
                                Başlık
                            </small>

                            <strong>
                                @Model.Title
                            </strong>

                        </div>


                        <div class="mb-3">

                            <small class="text-muted d-block mb-1">
                                Açıklama
                            </small>

                            <span>
                                @Model.Description
                            </span>

                        </div>


                        <hr />


                        <div class="row g-3">

                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    İkon
                                </small>

                                <strong>
                                    @Model.IconUrl
                                </strong>

                            </div>


                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    İkon Başlığı
                                </small>

                                <strong>
                                    @Model.IconTitle
                                </strong>

                            </div>


                            <div class="col-12">

                                <small class="text-muted d-block mb-1">
                                    İkon Açıklaması
                                </small>

                                <span>
                                    @Model.IconDescription
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- WARNING -->
                    <div class="alert alert-warning text-start">

                        <i class="fa fa-exclamation-triangle me-2"></i>

                        <strong>Dikkat:</strong>

                        Bu işlem geri alınamaz. Özellik kaydı
                        sistemden kalıcı olarak silinecektir.

                    </div>


                    <!-- BUTTONS -->
                    <div class="d-flex justify-content-center gap-2 mt-4">

                        <a asp-controller="Features"
                           asp-action="AllFeatures"
                           class="btn btn-outline-secondary px-4">

                            <i class="fa fa-arrow-left me-1"></i>
                            Vazgeç

                        </a>


                        <form asp-controller="Features"
                              asp-action="DeleteFeaturesConfirmed"
                              method="post">

                            <input type="hidden"
                                   name="featuresId"
                                   value="@Model.FeaturesId" />


                            <button type="submit"
                                    class="btn btn-danger px-4">

                                <i class="fa fa-trash me-1"></i>
                                Evet, Özelliği Sil

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>