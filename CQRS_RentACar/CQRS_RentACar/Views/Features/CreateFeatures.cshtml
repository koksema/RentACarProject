@model CQRS_RentACar.CQRSPattern.Commands.FeaturesCommands.CreateFeaturesCommand

@{
    ViewData["Title"] = "Yeni Özellik Ekle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">

    <div class="row justify-content-center">

        <div class="col-xl-9 col-lg-10">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="me-3"
                             style="
                                width:48px;
                                height:48px;
                                border-radius:12px;
                                background:#eaf4ff;
                                color:#1688e7;
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                font-size:19px;
                             ">

                            <i class="fa fa-star"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-1">
                                Yeni Özellik Ekle
                            </h5>

                            <small class="text-muted">
                                Ana sayfada gösterilecek yeni bir özellik oluşturabilirsiniz.
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body p-4">

                    <form asp-controller="Features"
                          asp-action="CreateFeatures"
                          method="post">

                        <div class="row g-4">


                            <!-- BAŞLIK -->
                            <div class="col-12">

                                <label asp-for="Title"
                                       class="form-label fw-semibold">
                                    Başlık
                                </label>

                                <input asp-for="Title"
                                       class="form-control"
                                       placeholder="Örn: Güvenli Araç Kiralama"
                                       required />

                            </div>


                            <!-- AÇIKLAMA -->
                            <div class="col-12">

                                <label asp-for="Description"
                                       class="form-label fw-semibold">
                                    Açıklama
                                </label>

                                <textarea asp-for="Description"
                                          class="form-control"
                                          rows="5"
                                          placeholder="Özellik hakkında açıklama giriniz..."
                                          required></textarea>

                            </div>


                            <!-- ICON URL -->
                            <div class="col-md-6">

                                <label asp-for="IconUrl"
                                       class="form-label fw-semibold">
                                    İkon
                                </label>

                                <input asp-for="IconUrl"
                                       class="form-control"
                                       placeholder="Örn: fa fa-car" />

                                <small class="text-muted">
                                    Kullanacağınız ikon sınıfını girin.
                                </small>

                            </div>


                            <!-- ICON TITLE -->
                            <div class="col-md-6">

                                <label asp-for="IconTitle"
                                       class="form-label fw-semibold">
                                    İkon Başlığı
                                </label>

                                <input asp-for="IconTitle"
                                       class="form-control"
                                       placeholder="Örn: Hızlı Teslimat" />

                            </div>


                            <!-- ICON DESCRIPTION -->
                            <div class="col-12">

                                <label asp-for="IconDescription"
                                       class="form-label fw-semibold">
                                    İkon Açıklaması
                                </label>

                                <textarea asp-for="IconDescription"
                                          class="form-control"
                                          rows="3"
                                          placeholder="İkon altında gösterilecek açıklama..."></textarea>

                            </div>


                            <!-- IMAGE URL -->
                            <div class="col-12">

                                <label asp-for="ImgUrl"
                                       class="form-label fw-semibold">
                                    Görsel
                                </label>

                                <input asp-for="ImgUrl"
                                       id="featureImageUrl"
                                       class="form-control"
                                       placeholder="/images/feature/feature.jpg" />

                                <small class="text-muted">
                                    Görselin URL veya dosya yolunu girin.
                                </small>

                            </div>


                            <!-- IMAGE PREVIEW -->
                            <div class="col-12">

                                <div id="featureImageBox"
                                     class="bg-light rounded p-4 text-center d-none">

                                    <small class="text-muted d-block mb-3">
                                        Görsel Önizleme
                                    </small>

                                    <img id="featureImagePreview"
                                         src=""
                                         alt="Özellik Görseli"
                                         style="
                                            width:100%;
                                            max-width:450px;
                                            height:220px;
                                            object-fit:cover;
                                            border-radius:12px;
                                         " />

                                </div>

                            </div>

                        </div>


                        <hr class="my-4" />


                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Features"
                               asp-action="AllFeatures"
                               class="btn btn-outline-secondary">

                                <i class="fa fa-arrow-left me-1"></i>
                                Vazgeç

                            </a>


                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="fa fa-save me-1"></i>
                                Özelliği Kaydet

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const input =
            document.getElementById("featureImageUrl");

        const preview =
            document.getElementById("featureImagePreview");

        const box =
            document.getElementById("featureImageBox");


        input.addEventListener("input", function () {

            const value = this.value.trim();

            if (value !== "") {

                preview.src = value;

                box.classList.remove("d-none");

            }
            else {

                preview.src = "";

                box.classList.add("d-none");

            }

        });

    });

</script>