@model CQRS_RentACar.CQRSPattern.Results.FeaturesResults.GetFeaturesByIdQueryResult

@{
    ViewData["Title"] = "Özellik Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">

    <div class="row justify-content-center">

        <div class="col-xl-9 col-lg-10">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="me-3"
                             style="
                                width:48px;
                                height:48px;
                                border-radius:12px;
                                background:#fff5e5;
                                color:#e6a020;
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                font-size:19px;
                             ">

                            <i class="fa fa-pencil"></i>

                        </div>


                        <div>

                            <h5 class="fw-bold mb-1">
                                Özellik Güncelle
                            </h5>

                            <small class="text-muted">
                                Mevcut özellik bilgilerini düzenleyebilirsiniz.
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body p-4">

                    <form asp-controller="Features"
                          asp-action="UpdateFeatures"
                          method="post">


                        <input type="hidden"
                               name="FeaturesId"
                               value="@Model.FeaturesId" />


                        <div class="row g-4">


                            <!-- TITLE -->
                            <div class="col-12">

                                <label class="form-label fw-semibold">
                                    Başlık
                                </label>

                                <input type="text"
                                       name="Title"
                                       value="@Model.Title"
                                       class="form-control"
                                       required />

                            </div>


                            <!-- DESCRIPTION -->
                            <div class="col-12">

                                <label class="form-label fw-semibold">
                                    Açıklama
                                </label>

                                <textarea name="Description"
                                          class="form-control"
                                          rows="5"
                                          required>@Model.Description</textarea>

                            </div>


                            <!-- ICON -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    İkon
                                </label>

                                <input type="text"
                                       name="IconUrl"
                                       value="@Model.IconUrl"
                                       class="form-control" />

                            </div>


                            <!-- ICON TITLE -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    İkon Başlığı
                                </label>

                                <input type="text"
                                       name="IconTitle"
                                       value="@Model.IconTitle"
                                       class="form-control" />

                            </div>


                            <!-- ICON DESCRIPTION -->
                            <div class="col-12">

                                <label class="form-label fw-semibold">
                                    İkon Açıklaması
                                </label>

                                <textarea name="IconDescription"
                                          class="form-control"
                                          rows="3">@Model.IconDescription</textarea>

                            </div>


                            <!-- IMAGE -->
                            <div class="col-12">

                                <label class="form-label fw-semibold">
                                    Görsel
                                </label>

                                <input type="text"
                                       name="ImgUrl"
                                       id="featureImageUrl"
                                       value="@Model.ImgUrl"
                                       class="form-control" />

                            </div>


                            <!-- CURRENT IMAGE -->
                            <div class="col-12">

                                <div class="bg-light rounded p-4 text-center">

                                    <small class="text-muted d-block mb-3">
                                        Mevcut Görsel
                                    </small>

                                    <img id="featureImagePreview"
                                         src="@Model.ImgUrl"
                                         alt="@Model.Title"
                                         style="
                                            width:100%;
                                            max-width:450px;
                                            height:220px;
                                            object-fit:cover;
                                            border-radius:12px;
                                         " />

                                </div>

                            </div>

                        </div>


                        <hr class="my-4" />


                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Features"
                               asp-action="AllFeatures"
                               class="btn btn-outline-secondary">

                                <i class="fa fa-arrow-left me-1"></i>
                                Vazgeç

                            </a>


                            <button type="submit"
                                    class="btn btn-warning text-white">

                                <i class="fa fa-save me-1"></i>
                                Değişiklikleri Kaydet

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const input =
            document.getElementById("featureImageUrl");

        const preview =
            document.getElementById("featureImagePreview");


        input.addEventListener("input", function () {

            preview.src = this.value;

        });

    });

</script>