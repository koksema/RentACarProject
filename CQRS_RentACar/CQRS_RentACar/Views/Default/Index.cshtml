    <!-- =====================================================
         REZERVASYON FİYATI HESAPLAMA
         ===================================================== -->

    <script>

        $(document).ready(function () {

            $(
                'select[name="CarId"], ' +
                'input[name="PickUpDate"], ' +
                'input[name="DropOffDate"], ' +
                'select[name="PickUpLocation"], ' +
                'input[name="DropOffLocation"]'
            )
            .on(
                'change input',
                function () {

                    calculatePrice();

                }
            );


            function calculatePrice() {

                const carId =
                    $('select[name="CarId"]').val();

                const pickUpDate =
                    $('input[name="PickUpDate"]').val();

                const dropOffDate =
                    $('input[name="DropOffDate"]').val();

                const pickUpLoc =
                    $('select[name="PickUpLocation"]').val()
                    ||
                    $('input[name="PickUpLocation"]').val();

                const dropOffLoc =
                    $('input[name="DropOffLocation"]').val();


                if (
                    carId &&
                    pickUpDate &&
                    dropOffDate
                ) {

                    $.ajax({

                        url:
                            '/Booking/CalculatePrice',

                        type:
                            'POST',

                        data: {

                            carId:
                                carId,

                            pickUpDate:
                                pickUpDate,

                            dropOffDate:
                                dropOffDate,

                            pickUpLocation:
                                pickUpLoc,

                            dropOffLocation:
                                dropOffLoc

                        },

                        success:
                            function (response) {

                                if (
                                    response.success
                                ) {

                                    $('#totalDays')
                                        .text(
                                            response.days +
                                            " Gün"
                                        );

                                    $('#totalPrice')
                                        .text(
                                            "₺" +
                                            Number(
                                                response.totalPrice
                                            )
                                            .toLocaleString(
                                                'tr-TR'
                                            )
                                        );


                                    if (
                                        response.differentLocationFee >
                                        0
                                    ) {

                                        $('#locationFeeNotice')
                                            .text(
                                                "+ ₺" +
                                                Number(
                                                    response
                                                        .differentLocationFee
                                                )
                                                .toLocaleString(
                                                    'tr-TR'
                                                ) +
                                                " farklı lokasyon teslim ücreti dahil"
                                            );

                                    }
                                    else {

                                        $('#locationFeeNotice')
                                            .text("");

                                    }


                                    $('#priceCalculationBox')
                                        .removeClass(
                                            'd-none'
                                        );

                                }

                            }

                    });

                }

            }

        });

    </script>


