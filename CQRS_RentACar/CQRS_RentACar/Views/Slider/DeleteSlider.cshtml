@model CQRS_RentACar.CQRSPattern.Results.SliderResults.GetSliderByIdQueryResult

@{
    ViewData["Title"] = "Slider Sil";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">

    <div class="row justify-content-center">

        <div class="col-xl-7 col-lg-9">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-5 text-center">


                    <!-- DELETE ICON -->
                    <div style="
                        width:75px;
                        height:75px;
                        margin:0 auto 20px;
                        border-radius:50%;
                        background:#fff0f1;
                        color:#e63946;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        font-size:28px;
                    ">

                        <i class="fa fa-trash"></i>

                    </div>


                    <h4 class="fw-bold mb-2">
                        Sliderı Sil
                    </h4>


                    <p class="text-muted mb-4">
                        Bu sliderı sistemden silmek
                        istediğinize emin misiniz?
                    </p>


                    <!-- SLIDER INFORMATION -->
                    <div class="bg-light rounded p-4 mb-4">


                        @if (!string.IsNullOrWhiteSpace(Model.ImgUrl))
                        {
                            <div class="mb-4">

                                <img src="@Model.ImgUrl"
                                     alt="@Model.Title"
                                     style="
                                            width:100%;
                                            max-width:550px;
                                            height:250px;
                                            object-fit:cover;
                                            border-radius:14px;
                                            box-shadow:0 5px 20px rgba(0,0,0,.08);
                                         " />

                            </div>
                        }


                        <h5 class="fw-bold mb-3">
                            @Model.Title
                        </h5>


                        <div class="row text-start">

                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Slider ID
                                </small>

                                <strong>
                                    #@Model.SliderId
                                </strong>

                            </div>


                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Başlık
                                </small>

                                <strong>
                                    @Model.Title
                                </strong>

                            </div>

                        </div>

                    </div>


                    <!-- WARNING -->
                    <div class="alert alert-warning text-start">

                        <i class="fa fa-exclamation-triangle me-2"></i>

                        <strong>Dikkat:</strong>

                        Bu işlem geri alınamaz.
                        Slider kaydı sistemden kalıcı olarak silinecektir.

                    </div>


                    <!-- BUTTONS -->
                    <div class="d-flex justify-content-center gap-2 mt-4">


                        <a asp-controller="Slider"
                           asp-action="AllSlider"
                           class="btn btn-outline-secondary px-4">

                            <i class="fa fa-arrow-left me-1"></i>
                            Vazgeç

                        </a>


                        <form asp-controller="Slider"
                              asp-action="DeleteSliderConfirmed"
                              method="post">


                            <input type="hidden"
                                   name="sliderId"
                                   value="@Model.SliderId" />


                            <button type="submit"
                                    class="btn btn-danger px-4">

                                <i class="fa fa-trash me-1"></i>
                                Evet, Sliderı Sil

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>