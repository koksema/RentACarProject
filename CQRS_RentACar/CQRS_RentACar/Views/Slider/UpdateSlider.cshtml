@model CQRS_RentACar.CQRSPattern.Results.SliderResults.GetSliderByIdQueryResult

@{
    ViewData["Title"] = "Slider Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">

    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-10">

            <div class="card border-0 shadow-sm">


                <!-- HEADER -->
                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="me-3"
                             style="
                                width:48px;
                                height:48px;
                                border-radius:12px;
                                background:#fff5e5;
                                color:#e6a020;
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                font-size:19px;
                             ">

                            <i class="fa fa-pencil"></i>

                        </div>


                        <div>

                            <h5 class="fw-bold mb-1">
                                Slider Güncelle
                            </h5>

                            <small class="text-muted">
                                #@Model.SliderId numaralı slider
                                bilgilerini düzenleyebilirsiniz.
                            </small>

                        </div>

                    </div>

                </div>


                <!-- BODY -->
                <div class="card-body p-4">


                    <form asp-controller="Slider"
                          asp-action="UpdateSlider"
                          method="post">


                        <!-- ID -->
                        <input type="hidden"
                               name="SliderId"
                               value="@Model.SliderId" />


                        <div class="row g-4">


                            <!-- TITLE -->
                            <div class="col-12">

                                <label class="form-label fw-semibold">
                                    Slider Başlığı
                                </label>

                                <input type="text"
                                       name="Title"
                                       value="@Model.Title"
                                       class="form-control"
                                       required />

                            </div>


                            <!-- IMAGE URL -->
                            <div class="col-12">

                                <label class="form-label fw-semibold">
                                    Slider Görseli
                                </label>

                                <input type="text"
                                       name="ImgUrl"
                                       id="sliderImageUrl"
                                       value="@Model.ImgUrl"
                                       class="form-control"
                                       required />

                                <small class="text-muted">
                                    Görsel adresini değiştirerek slider
                                    görselini güncelleyebilirsiniz.
                                </small>

                            </div>


                            <!-- IMAGE PREVIEW -->
                            <div class="col-12">

                                <div class="bg-light rounded p-4 text-center">

                                    <small class="text-muted d-block mb-3">
                                        Mevcut Slider Görseli
                                    </small>


                                    <img id="sliderImagePreview"
                                         src="@Model.ImgUrl"
                                         alt="@Model.Title"
                                         style="
                                            width:100%;
                                            max-width:650px;
                                            height:300px;
                                            object-fit:cover;
                                            border-radius:14px;
                                            box-shadow:0 6px 25px rgba(0,0,0,.08);
                                         " />

                                </div>

                            </div>

                        </div>


                        <hr class="my-4" />


                        <!-- BUTTONS -->
                        <div class="d-flex justify-content-end gap-2">


                            <a asp-controller="Slider"
                               asp-action="AllSlider"
                               class="btn btn-outline-secondary">

                                <i class="fa fa-arrow-left me-1"></i>
                                Vazgeç

                            </a>


                            <button type="submit"
                                    class="btn btn-warning text-white">

                                <i class="fa fa-save me-1"></i>
                                Değişiklikleri Kaydet

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const input =
            document.getElementById("sliderImageUrl");

        const preview =
            document.getElementById("sliderImagePreview");


        input.addEventListener("input", function () {

            const imageUrl = this.value.trim();

            preview.src = imageUrl;

        });

    });

</script>